request = (op, payload) ->
  invocation = invocationScope.getStore()
  unless invocation?
    return Promise.reject new Error('Isolated request has no active host invocation')
  id = String(++sequence)
  new Promise (resolve, reject) ->
    pending.set id, {resolve, reject}
    hostProcess.send Object.assign({op, id, invocation}, payload), (error) ->
      if error and pending.delete(id)
        reject error

requestEvent = (event, payload) ->
  request 'event',
